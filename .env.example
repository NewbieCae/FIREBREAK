# Copier ce fichier en .env.local (ignoré par Git) et renseigner les valeurs.
# Ne JAMAIS commiter de vraies clés ni de vrais secrets.

# IA : mock (défaut, hors ligne) ou bedrock
FIREBREAK_AI=mock
# AWS_REGION=us-east-1

# Fédération : optionnels. Sans valeur, un secret aléatoire est tiré à chaque
# lancement (jetons et clés différents d'un lancement à l'autre).
# Pour une démo reproductible, mettre ici des valeurs de TEST (pas de vrai secret).
# FIREBREAK_PAIR_SECRET=
# FIREBREAK_KEY_SEED=
